#!/bin/sh
set -eu
# Only check stock tools. No installation of packages or disk changes here.
for tool in python3 mdadm pvs lvs lvchange vgcfgbackup vgrename lvrename btrfs dmsetup losetup mount umount runuser systemctl; do
    command -v "$tool" >/dev/null || exit 1
done
/usr/bin/python3 -c 'import platform,sys;sys.exit(0 if platform.system()=="Linux" and sys.version_info>=(3,9) else 1)'
